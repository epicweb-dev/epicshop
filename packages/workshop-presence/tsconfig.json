{
	"include": ["./src/**/*.ts", "./src/**/*.tsx"],
	"extends": ["@epic-web/config/typescript"],
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./dist",
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"rewriteRelativeImportExtensions": true,
		"types": ["@cloudflare/workers-types", "vitest/importMeta"]
	},
	"exclude": ["dist"]
}
